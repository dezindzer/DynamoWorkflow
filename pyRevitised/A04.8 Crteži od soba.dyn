    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "gTitle = \"View Template\";\n\nvalues = viewTemp;\n\nviewTempName = Revit.Elements.Element.Name(viewTemp);\n\nstr = dtCore.String.FromObject(viewTemp);\nosnova = \"Osnova 1.50\";\nplafoni = \"Plafoni 1.50\";\npogledi = \"Pogledi 1.50\";\nda = true;\n\nosnovaName = \"Osnove\";\nbool1 = DSCore.String.Contains(str, osnova, da);\nDSCore.List.AllIndicesOf(da, bool1);\n\nplafoniName = \"Plafoni\";\nbool2 = DSCore.String.Contains(str, plafoni, da);\nDSCore.List.AllIndicesOf(da, bool2);\n\npoglediName = \"Pogledi\";\nbool3 = DSCore.String.Contains(str, pogledi, da);\nDSCore.List.AllIndicesOf(da, bool3);",
