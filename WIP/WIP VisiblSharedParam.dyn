    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\n\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\n\r\n#Get the path and GUIDs for the parameters to change\r\npath = IN[0]\r\nguids = IN[1]\r\nwriteLines = []\r\n#set up the separator, here it is \\t TAB\r\nsep = '\\t'\r\n\r\n#open the shared parameters file to read\r\nwith open(path) as f:\r\n#Read each line of the file\r\n\tlines = f.readlines()\r\n\tfor line in lines:\r\n#Create a temp string to add to the collection\r\n\t\ttempLine = line\r\n#This line helps skip all the stuff at the beginning of the file\r\n\t\tif line.startswith(\"PARAM\"):\r\n#Iterate through each of the GUIDs selected\r\n\t\t\tfor guid in guids:\r\n#Create a parts array to hold each index of the line when split\r\n\t\t\t\tparts = []\r\n#Check to see if the GUID is in the line\r\n\t\t\t\tif guid.ToString() in line:\r\n#If so, split the line by the tab separator\r\n\t\t\t\t\tparts = line.split(sep)\r\n#Check to see if the paramter is Visible or not and set the value to the correct part index\r\n\t\t\t\t\tif IN[2]:\r\n\t\t\t\t\t\tparts[6] = '1'\r\n\t\t\t\t\telse:\r\n\t\t\t\t\t\tparts[6] = '0'\r\n#Set the tempLine to the new string after joining the parts back together\r\n\t\t\t\t\ttempLine = sep.join(parts)\r\n#Since we found the correct parameter, break the for loop for speed\r\n\t\t\t\t\tbreak\r\n#Add the tempLine to the writeLines list\r\n\t\twriteLines.Add(tempLine)\r\n\r\nOUT = writeLines,path",
      "VariableInputPorts": true,
      "Id": "0869d9f06f894e3ab29028807cb51055",
      "Inputs": [
        {
          "Id": "f14d2d2ea35848af9159516126df12d2",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
