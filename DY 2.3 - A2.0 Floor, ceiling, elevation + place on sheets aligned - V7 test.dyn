    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import System\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndef CollectByView(bic, view):\r\n\tcollector = FilteredElementCollector(doc)\r\n\tfilter = ElementOwnerViewFilter(view.Id)\r\n\treturn collector.WherePasses(filter).OfCategory(bic).ToElements()\r\n\r\ndef GetViewDependentElements(cat, views):\r\n\tif isinstance(views, list): return [CollectByView(cat, x) for x in UnwrapElement(views)]\r\n\telse: return CollectByView(cat, UnwrapElement(views))\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\ncats = IN[0]\r\nviews = IN[1]\r\n\r\nif isinstance(IN[0], list): OUT = [GetViewDependentElements(x, views) for x in cats]\r\nelse: OUT = GetViewDependentElements(cats, views)",
      "VariableInputPorts": true,
      "Id": "e8a99d9ae728485caf3e4c2ef94517b9",
      "Inputs": [
        {
          "Id": "da456d04bb134d0385839391db493d76",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a3aae952ba78451eb8939be08be8c631",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "91a46f4a3e3a4a548bd6e9aff69c353c",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "4f15f39e3c9d4310b8b5e99bcba03f79",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded IronPython script."
    },
