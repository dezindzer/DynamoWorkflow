          "KeepListStructure": false
        },
        {
          "Id": "577946bd6c2a4dbe9a8c645c269befe5",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "07897e5e383843cbbee0efe00cae4f8c",
