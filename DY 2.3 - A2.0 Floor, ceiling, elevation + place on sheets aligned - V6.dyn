    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "################### Import References ###################\nimport clr\n\nclr.AddReference(\"ProtoGeometry\")\nfrom Autodesk.DesignScript import Geometry as geom\nclr.AddReference(\"RevitServices\")\nimport RevitServices\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\ndoc =  DocumentManager.Instance.CurrentDBDocument\napp = DocumentManager.Instance.CurrentUIApplication.Application\n\nclr.AddReference(\"RevitNodes\")\nimport Revit\nclr.ImportExtensions(Revit.Elements)\nclr.ImportExtensions(Revit.GeometryConversion)\n\nclr.AddReference(\"RevitAPI\")\nfrom Autodesk.Revit.DB import *\n\nimport System\nfrom System.Collections.Generic import *\n################### Definitions ###################\ndef tolist(obj1):\n\tif hasattr(obj1,\"__iter__\"): return obj1\n\telse: return [obj1]\n################### Input Variables ###################\n#get the sheet in port IN[1] and UnwrapElement if not already...\nviews = tolist(UnwrapElement(IN[0]))\n################### Output Variables ###################\noutList = []\n################### other Variables ###################\n#conversion between ft and mm\nft2mm = 304.8\n################### Script ###################\nfor v in views:\n\t#get outline\n\toLine = v.Outline\n\tminU = oLine.Min.U*304.8\n\tminV = oLine.Min.V*304.8\n\tmaxU = oLine.Max.U*304.8\n\tmaxV = oLine.Max.V*304.8\n\t\n\t#get width and length of Rectangle\n\tw = maxU-minU\n\tl = maxV-minV\n\t\n\t#create rectangle\n\tmyRec = geom.Rectangle.ByWidthLength(w,l)\n\t#move rectangle so bottom left corner is at origin\n\tmyRec2 = geom.Geometry.Translate(myRec,w/2,l/2,0)\n\t#add rectangle to output list\n\toutList.append(myRec2)\n\nOUT = outList\n\t",
      "VariableInputPorts": true,
      "Id": "f7e48ef937404a85a94e9dc318c588cc",
      "Inputs": [
        {
          "Id": "57353a7644e04eff9cd6b93b05f871c2",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "6696516173254b4e803be7ed9b6a1309",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded IronPython script."
    },
