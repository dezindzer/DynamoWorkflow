    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Copyright(c) 2015, Dan Rumery\n# BVN, http://www.bvn.com.au/\n# Licence: http://creativecommons.org/licenses/by-sa/4.0/\n\n\nimport clr\nclr.AddReference('ProtoGeometry')\nfrom Autodesk.DesignScript.Geometry import *\n\n#The inputs to this node will be stored as a list in the IN variable.\nparameters = IN[0]\nrooms = IN[1]\ndoors = IN[2]\n\nsorted_params = []\nsorted_rooms = []\nsorted_doors = []\n\nfor rs, ds, ps in zip(rooms, doors, parameters):\n  room = rs[0]\n  \n  # This calculates a list of pairs (param, door) sorted by param.\n  sorted_params_and_doors = sorted(zip(ps, ds), key=lambda param_and_door: param_and_door[0])\n  \n  # Build the output lists\n  sorted_rooms.append(rs) # No need to sort the rooms\n  sorted_doors.append(list(door for param, door in sorted_params_and_doors))\n  sorted_params.append(list(param for param, door in sorted_params_and_doors))\n\noutList = [sorted_params, sorted_rooms, sorted_doors]\n\n#Assign your output to the OUT variable\nOUT = outList\n",
      "VariableInputPorts": true,
      "Id": "15a756fca44d40b5886d40861bcd8f42",
      "Inputs": [
        {
          "Id": "40da593a33c44704a1665d8e52ac4b0f",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "dd7e8fca52d541e0b09151d4901e8fc6",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1eb3ae32e24a4d798671c8119878c3db",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2d4d7c658ff642649b93f4b708ec9480",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "8e98c4e353c446e08ec262668adcbeb0",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
