      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "\"Broj Zidnih Panela\";\nzidni= DSCore.List.Count(a@L2<1>);\n\nsoba = room;\n\n\"Broj Plafonskih Panela\";\nplafonski = DSCore.List.Count(b@L2<1>);",
      "Id": "f8ea905581694605b5fb49b9d02227be",
      "Inputs": [
        {
          "Id": "177be9d32ea9451ea2366818d3444a1f",
          "Name": "a",
